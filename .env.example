POSTGRES_DB=price_monitor
POSTGRES_USER=price_monitor
POSTGRES_PASSWORD=price_monitor_dev
POSTGRES_PORT=5433
REDIS_PORT=6380
DATABASE_URL=postgresql://price_monitor:price_monitor_dev@localhost:5433/price_monitor?schema=public
API_PORT=4100
# Keep the API loopback-only unless a protected private-network deployment is explicitly enabled.
API_HOST=127.0.0.1
ALLOW_PRIVATE_NETWORK_API=false
PUBLIC_BASE_URL=http://127.0.0.1:4100
COLLECTOR_REPORT_JSON_LIMIT=8mb
SETTINGS_MASTER_KEY=replace-with-a-long-random-secret
# Production accepts exactly 64 hexadecimal characters and rejects common weak repeated patterns.
# This is a strict format and weak-pattern check, not proof of entropy. Generate with: openssl rand -hex 32
# Development/test may leave this empty; ADMIN routes then remain unavailable.
# Enter the same value through the web "管理员解锁" control and use "锁定" to clear that tab session.
ADMIN_API_TOKEN=
ADMIN_API_ACTOR_ID=local-admin
